{
  "$defs": {
    "AiDelta": {
      "properties": {
        "attempt": {
          "maximum": 3,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "chunk_index": {
          "minimum": 0,
          "title": "Chunk Index",
          "type": "integer"
        },
        "control_epoch": {
          "minimum": 0,
          "title": "Control Epoch",
          "type": "integer"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "ai.delta",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation_id",
        "run_id",
        "control_epoch",
        "attempt",
        "chunk_index",
        "text"
      ],
      "title": "AiDelta",
      "type": "object"
    },
    "DurableEvent": {
      "properties": {
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "data": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Data",
          "type": "object"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "enum": [
            "conversation.created",
            "message.created",
            "conversation.control_changed",
            "conversation.resolved",
            "conversation.reopened",
            "read_cursor.updated",
            "ai.run_changed"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event_id",
        "conversation_id",
        "seq",
        "occurred_at",
        "data"
      ],
      "title": "DurableEvent",
      "type": "object"
    },
    "PresenceUpdate": {
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "online": {
          "title": "Online",
          "type": "boolean"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "type": {
          "const": "presence.updated",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation_id",
        "actor_id",
        "online"
      ],
      "title": "PresenceUpdate",
      "type": "object"
    },
    "TypingUpdate": {
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "title": "Conversation Id",
          "type": "string"
        },
        "expires_in": {
          "const": 5,
          "default": 5,
          "title": "Expires In",
          "type": "integer"
        },
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "type": {
          "const": "typing.updated",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "conversation_id",
        "actor_id"
      ],
      "title": "TypingUpdate",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/DurableEvent"
    },
    {
      "$ref": "#/$defs/AiDelta"
    },
    {
      "$ref": "#/$defs/TypingUpdate"
    },
    {
      "$ref": "#/$defs/PresenceUpdate"
    }
  ],
  "title": "RealtimeFrame"
}
