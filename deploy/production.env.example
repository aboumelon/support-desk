# Copy to a private .env.production; do not commit real values.
COMPOSE_PROJECT_NAME=supportdesk-production
RELEASE_ID=replace-with-local-source-revision
APP_ENV=production
COOKIE_SECURE=true
PUBLIC_BASE_URL=https://tarvio.example.invalid
ALLOWED_ORIGINS=["https://tarvio.example.invalid"]
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=true
# Only the gateway is published. Freestyle requires 0.0.0.0 plus a TLS ingress rule.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
PRIVATE_SUBNET=172.30.29.0/24
PRIVATE_DYNAMIC_RANGE=172.30.29.128/25
PRIVATE_BRIDGE_IP=172.30.29.1
GATEWAY_PRIVATE_IP=172.30.29.2
# Replace with actual trusted ingress proxy CIDRs before public routing. Never use 0/0.
EDGE_TRUSTED_PROXIES=127.0.0.1/32
POSTGRES_OWNER_PASSWORD=replace-with-a-strong-owner-secret
MIGRATION_DATABASE_URL=postgresql+psycopg://supportdesk_owner:replace-with-a-strong-owner-secret@postgres:5432/supportdesk
RUNTIME_DATABASE_URL=postgresql+psycopg://supportdesk_runtime:replace-with-a-strong-runtime-secret@postgres:5432/supportdesk
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Model capacity does not set reservation size: application input is independently capped.
LLM_CONTEXT_LIMIT=8192
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=800
AI_TOTAL_TIMEOUT_SECONDS=90
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=15
LLM_RETRY_AFTER_MAX_SECONDS=30
AI_DAILY_TOKEN_LIMIT=100000
AI_PROVIDER_DAILY_TOKEN_LIMIT=200000
AI_MAX_CONCURRENT=1
AI_MAX_QUEUED=10
# Enable only for a provider that permits this public use, with separate authorization.
PUBLIC_LIVE_AI_ENABLED=false
DEMO_DAILY_LIMIT=50
DEMO_ACTIVE_LIMIT=50
UPLOAD_DAILY_LIMIT=20
INGESTION_MAX_QUEUED=5
STORAGE_MAX_BYTES=268435456
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
